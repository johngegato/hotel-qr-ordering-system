engine-strict=false
registry=https://registry.npmjs.org/
fetch-retries=5
fetch-retry-factor=2
# NOTE: pnpm hoist directives (shamefully-hoist, hoist-pattern, public-hoist-pattern)
# were removed from this file because pnpm (>=9.x) silently ignores them when placed
# in .npmrc. They MUST live in pnpm-workspace.yaml instead — see that file.
# Leaving them here caused "Failed to resolve plugin for module 'expo-secure-store'"
# on EAS Build. See DEBUG_PLAN.md §1.5 / chat-history/2026-09-04_eas-build-fix-verification.md.
